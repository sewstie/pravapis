# The conformance corpus is a byte-exact artifact: `pravapis export-conformance --check`
# compares the committed bytes against freshly generated ones, and CI fails on a
# difference. With core.autocrlf=true (the Windows default) git would rewrite the line
# endings on checkout and every Windows contributor would see a spurious "stale corpus"
# failure. -text tells git to leave these files exactly as committed, on every platform.
conformance/cases.jsonl -text
conformance/known_failures.jsonl -text
conformance/manifest.json -text

# Same reasoning, weaker stakes: the data files carry the content the corpus is
# generated from, and a hash over them should not depend on who checked them out.
data/VERSION -text
data/MANIFEST -text
data/chars/*.tsv -text
data/rules/*.yaml -text
data/lexicon/*.tsv -text
data/lexicon/stems/*.tsv -text
data/lexicon/case/*.tsv -text
data/morphology/function_words.tsv -text
data/morphology/*.marisa -text
data/stress/*.marisa -text
data/translit/*.yaml -text
